# Backend async job recovery task configuration

# Set to 1 to simulate a failure after a side effect is performed.
FAIL_AFTER_EFFECT=0

# Path to the SQLite database used for job persistence.
JOB_DB_PATH=/data/jobs.db

# Number of seconds a worker lease remains valid.
JOB_LEASE_SECONDS=2

# Number of seconds workers wait between polling attempts.
WORKER_POLL_INTERVAL=0.1
