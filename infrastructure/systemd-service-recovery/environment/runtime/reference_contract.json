{
  "service": "forge-worker",
  "user": "forge",
  "group": "forge",
  "environment_file": "/etc/forge/worker.env",
  "network_target": "network-online.target",
  "config_validation": true,
  "readiness_after_start": true,
  "restart_on_failure": true,
  "restart_policy": "on-failure",
  "restart_sec": 3,
  "start_limit_burst": 5,
  "start_limit_interval_sec": 60,
  "memory_max_mb": 512,
  "nice": 5,
  "no_new_privileges": true,
  "command": "/usr/local/bin/forge-worker --serve"
}